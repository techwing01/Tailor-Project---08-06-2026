# ============================================================
# TailorMate Environment Configuration
# ============================================================
# Copy this file to .env and provide real production values.
# NEVER commit .env.

# Application / Database
DB_HOST=mariadb
DB_PORT=3306
DB_USER=tailormate_user
DB_PASS=CHANGE_ME
DB_NAME=tailormate

# MariaDB
MARIADB_ROOT_PASSWORD=CHANGE_ME

# Email - Resend
RESEND_API_KEY=

# TailorMate administrator
# Use a strong unique password in the real .env file.
ADMIN_PASSWORD=CHANGE_ME
